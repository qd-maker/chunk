# 复制成 .env 再填。不填 key 也能启动，但练习时会报「没有配置 API key」。

# 转写：走 OpenRouter 的 openai/whisper-1。
# key 在 https://openrouter.ai/settings/keys 创建，账户里要有余额。
OPENROUTER_API_KEY=

# 出题和判定：任意 OpenAI 兼容接口（带 /chat/completions 的那一层地址，例如 https://api.example.com/v1）。
# 三项都不填 = 也走 OpenRouter，用上面的 key。
# LLM_API_KEY 去你用的那家服务的控制台拿；LLM_MODEL 写那家服务认的模型名。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5

# 登录密码。部署到公网必须设；本机自己用可以留空（不用登录）。
APP_PASSWORD=
# Cookie 签名密钥，填一串长随机字符，例如 openssl rand -hex 32 的输出。
# 留空时从 APP_PASSWORD 推出来，改密码后所有人都要重新登录。
SESSION_SECRET=

# true = 不调任何付费接口，用内置的假转写和假判定（看界面、跑测试用）
FAKE_UPSTREAM=false

# 每天建议激活几个新表达（超过要确认，硬上限 5）
NEW_PER_DAY=3
